Add --preserve-client-edns option (default off): a forwarder only adds an EDNS0
OPT to an upstream query when the client's query already carried one (or DNSSEC
needs it). Lets dnsmasq resolve via upstreams that silently drop OPT-bearing
queries (e.g. anti-amplification gateways) while keeping EDNS/DNSSEC for clients
that ask for it. Clean-room addition for the RTL960x ONU; SPDX unchanged.
--- SPDX-License-Identifier: GPL-2.0

--- a/src/dnsmasq.h
+++ b/src/dnsmasq.h
@@ -289,7 +289,8 @@
 #define OPT_DO_0x20        75
 #define OPT_AUTH_LOG       76
 #define OPT_LEASEQUERY     77
-#define OPT_LAST           78
+#define OPT_PRESERVE_EDNS  78
+#define OPT_LAST           79
 
 #define OPTION_BITS (sizeof(unsigned int)*8)
 #define OPTION_SIZE ( (OPT_LAST/OPTION_BITS)+((OPT_LAST%OPTION_BITS)!=0) )
