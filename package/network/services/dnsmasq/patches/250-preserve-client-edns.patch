--- a/src/forward.c
+++ b/src/forward.c
@@ -513,8 +513,16 @@
 
   forwarded = 0;
 
-  /* Advertise the size of UDP reply we can accept. */
-  plen = add_pseudoheader(header, plen, (unsigned char *)(header + daemon->edns_pktsz), 0, NULL, 0, 0, 0);
+  /* Advertise the size of UDP reply we can accept. With preserve-client-edns,
+     only normalise an EDNS OPT the client (or DNSSEC's add_do_bit, above) already
+     supplied — never add an OPT to a plain client query. Some upstreams silently
+     drop OPT-bearing queries from certain sources; a forwarder may preserve the
+     client's EDNS state (RFC6891) so the ONU's own non-EDNS system queries still
+     resolve. DNSSEC/EDNS-client queries keep their OPT and are unaffected. */
+  if (!option_bool(OPT_PRESERVE_EDNS) ||
+      option_bool(OPT_DNSSEC_VALID) ||
+      find_pseudoheader(header, plen, NULL, NULL, NULL, NULL))
+    plen = add_pseudoheader(header, plen, (unsigned char *)(header + daemon->edns_pktsz), 0, NULL, 0, 0, 0);
 
