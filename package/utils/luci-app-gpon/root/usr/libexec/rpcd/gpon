#!/bin/sh
# ubus/rpcd backend for the LuCI GPON status panel. Parses /proc/gpon and
# returns the ONU activation state + the fiber RX/TX optical power in dBm.
# Method: `ubus call gpon status`.
. /usr/share/libubox/jshn.sh

raw_to_dbm() {
	# arg = hex word from /proc/gpon optic_*_raw (SFF-8472 DDM, 0.1uW/LSB).
	# dBm = 10*log10(raw/10000). 0x0000/0xffff (dark/unfit) -> "n/a".
	local dec=$(( 0x${1:-0} ))
	[ "$dec" -gt 0 ] && [ "$dec" -lt 65535 ] || { echo "n/a"; return; }
	awk -v r="$dec" 'BEGIN { printf "%.1f", 10 * log(r / 10000.0) / log(10) }'
}

case "$1" in
list)
	echo '{ "status": {} }'
	;;
call)
	case "$2" in
	status)
		line=$(grep -a '^onu_state:' /proc/gpon 2>/dev/null)
		st=$(echo "$line"   | sed -n 's/.*O\([0-9]\).*/\1/p')
		name=$(echo "$line" | sed -n 's/.*(\([^)]*\)).*/\1/p')
		rxr=$(sed -n 's/^optic_rx_raw: 0x\([0-9a-fA-F]*\).*/\1/p' /proc/gpon 2>/dev/null)
		txr=$(sed -n 's/.*optic_tx_raw: 0x\([0-9a-fA-F]*\).*/\1/p' /proc/gpon 2>/dev/null)
		los=$(sed -n 's/.*optic_los=\([0-9]\).*/\1/p' /proc/gpon 2>/dev/null | head -1)

		json_init
		json_add_int     onu_state      "${st:-0}"
		json_add_string  onu_state_name "${name:-unknown}"
		[ "${st:-0}" = "5" ] && json_add_boolean online 1 || json_add_boolean online 0
		# No fiber light (LOS) -> there is no valid optical power to report;
		# show "n/a" rather than a stale last-good dBm reading.
		if [ "${los:-0}" = "1" ]; then
			json_add_string optic_rx_dbm "n/a"
			json_add_string optic_tx_dbm "n/a"
		else
			json_add_string optic_rx_dbm "$(raw_to_dbm "$rxr")"
			json_add_string optic_tx_dbm "$(raw_to_dbm "$txr")"
		fi
		json_add_boolean los            "${los:-0}"
		json_dump
		;;
	esac
	;;
esac
