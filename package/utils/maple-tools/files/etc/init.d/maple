#!/bin/sh /etc/rc.common
# Maple GPON driver init — starts the SNMP subagent if enabled in UCI.
# The kernel module (kmod-maple) auto-loads via /etc/modules.d/80-maple; this
# script only handles the userspace SNMP subagent.

START=99
USE_PROCD=1

start_service() {
	local enabled
	config_load maple
	config_get enabled main snmp 0

	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/maple_snmp
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall maple_snmp 2>/dev/null
}
