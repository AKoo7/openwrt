#!/bin/sh
# Per-board WiFi personalization (runs at boot, before netifd brings up wireless).
# Many ONUs share one RF zone, so derive a UNIQUE SSID from the board MAC to
# avoid SSID collisions, and default to WPA2-PSK (never open). See CLAUDE.md
# "WiFi defaults". The PSK below is a per-board-unique DEFAULT derived from
# MAC+SN; the operator should override it from provisioning.

# Authoritative per-board MAC/SN from this unit's own flash (same source as the
# GPON identity), with a netdev fallback.
MAC=$(/usr/sbin/rtk_factory -p config mac 2>/dev/null | tr 'A-F' 'a-f')
[ -n "$MAC" ] || MAC=$(cat /sys/class/net/eth0/address 2>/dev/null)
SN=$(/usr/sbin/rtk_factory -p config sn 2>/dev/null)

# SSID = ONU-<last 3 MAC octets> (e.g. 98:c7:a4:32:82:ae -> ONU-3282AE).
SUFFIX=$(echo "$MAC" | awk -F: 'NF>=6 { printf "%s%s%s", toupper($4), toupper($5), toupper($6) }')
[ -n "$SUFFIX" ] || SUFFIX="000000"
SSID="ONU-$SUFFIX"

# Per-board-unique default PSK (>=8 chars). Operator overrides via provisioning.
PSK=$(printf '%s' "${MAC}${SN}" | sha256sum 2>/dev/null | cut -c1-12)
[ "${#PSK}" -ge 8 ] || PSK="onu-${SUFFIX}-wifi"

uci -q batch <<EOF
set wireless.default_radio0.ssid='$SSID'
# WPA2-PSK for now. WPA2/WPA3-mixed (sae-mixed) needs 802.11w/PMF, which the rtl8192fe
# AP driver does not yet support -- with sae-mixed a WPA3-first phone fails SAE and may
# not fall back, giving zero association. WPA2-only is deterministic (all clients use the
# WPA2 path). Re-enable sae-mixed once PMF is added to the driver.
set wireless.default_radio0.encryption='psk2'
set wireless.default_radio0.key='12345678'
set wireless.radio0.country='BO'
# Enable 802.11b/CCK legacy rates (1/2/5.5/11) so the beacon is a standard 2.4GHz
# beacon transmitted at 1 Mbit CCK. Without this (OpenWrt default legacy_rates=0)
# the AP is OFDM-only and beacons at 6 Mbit; some phones will NOT list a 2.4GHz AP
# that has no CCK basic rates -- confirmed: with legacy_rates the phone sees the AP
# where before it was invisible. (An mt7921e/Linux client is lenient and saw it either
# way; strict phone scan firmware requires the CCK-rate beacon.)
set wireless.radio0.legacy_rates='1'
commit wireless
EOF

exit 0
