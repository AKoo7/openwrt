config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy0'
	option channel '7'
	option band '2g'
	option htmode 'HT20'
	option country 'BO'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	# ssid + key are overwritten per-board at boot by /etc/uci-defaults/99-onu-wifi
	# (SSID derived from the board MAC to avoid collisions; PSK from provisioning).
	# These remain only as a never-open fallback if that script can't read the MAC.
	option ssid 'ONU-X111W-AP'
	option encryption 'psk2'
	option key '12345678'
