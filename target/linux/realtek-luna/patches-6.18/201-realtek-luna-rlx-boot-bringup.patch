+#ifndef MODULES_VADDR
+/* Free memory returned from module_alloc */
+void arch_execmem_free(void *ptr)
+{
+	if (is_phys_addr(ptr))
+		free_phys(ptr);
+	else
+		vfree(ptr);
+}
+#endif
+
+static void *__module_alloc(int size, bool phys)
+{
+	void *ptr;
+
+	if (phys)
+		ptr = kmalloc(size, GFP_KERNEL);
+	else
+		ptr = vmalloc(size);
+	return ptr;
+}
+
+static void __module_free(void *ptr)
+{
+	if (is_phys_addr(ptr))
+		kfree(ptr);
+	else
+		vfree(ptr);
+}
