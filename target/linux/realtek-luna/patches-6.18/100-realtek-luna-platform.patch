Subject: [PATCH] mips: add Realtek Luna GPON ONU (RTL960xC) platform

--- a/arch/mips/Kbuild.platforms
+++ b/arch/mips/Kbuild.platforms
@@ -22,6 +22,7 @@ platform-$(CONFIG_MIPS_MALTA)		+= mti-ma
 platform-$(CONFIG_MACH_NINTENDO64)	+= n64/
 platform-$(CONFIG_PIC32MZDA)		+= pic32/
 platform-$(CONFIG_RALINK)		+= ralink/
+platform-$(CONFIG_REALTEK_LUNA)	+= realtek-luna/
 platform-$(CONFIG_MIKROTIK_RB532)	+= rb532/
 platform-$(CONFIG_SGI_IP22)		+= sgi-ip22/
 platform-$(CONFIG_SGI_IP27)		+= sgi-ip27/
--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -676,6 +676,44 @@ config MACH_NINTENDO64
 	select DMA_NONCOHERENT
 	select IRQ_MIPS_CPU

+config REALTEK_LUNA
+	bool "Realtek Luna GPON ONU (RTL960xC RLX Taroko / RTL9607C interAptiv)"
+	select BOOT_RAW
+	select COMMON_CLK
+	select DMA_NONCOHERENT
+	select IRQ_MIPS_CPU
+	select IRQ_DOMAIN
+	select USE_OF
+	select TIMER_OF
+	select SYS_HAS_CPU_MIPS32_R1
+	select SYS_HAS_CPU_MIPS32_R2
+	select SYS_HAS_EARLY_PRINTK
+	select SYS_SUPPORTS_32BIT_KERNEL
+	select SYS_SUPPORTS_BIG_ENDIAN
+	select CPU_R4K_CACHE_TLB
+	select HAVE_PCI
+	# Two SoC families share this platform; gate each one's CPU features on
+	# its CPU choice so the per-subtarget config selects exactly one:
+	#   RTL960xC "Taroko" (RLX, MIPS32 R1): R3000-style single-EntryLo TLB
+	#     (6-bit ASID) paired with an r4k-style cache.
+	select CPU_R3K_TLB if CPU_MIPS32_R1
+	#   RTL9607C "interAptiv" (MIPS32 R2): R4000 TLB (8-bit ASID) in a
+	#     Coherent Processing System, with a GIC, the R2 vectored/external
+	#     interrupt modes and the Realtek Otto SoC timer.
+	select SYS_SUPPORTS_SMP if CPU_MIPS32_R2
+	select SYS_SUPPORTS_MIPS_CPS if CPU_MIPS32_R2
+	select MIPS_CPU_SCACHE if CPU_MIPS32_R2
+	select MIPS_GIC if CPU_MIPS32_R2
+	select CLKSRC_MIPS_GIC if CPU_MIPS32_R2
+	select CPU_MIPSR2_IRQ_VI if CPU_MIPS32_R2
+	select CPU_MIPSR2_IRQ_EI if CPU_MIPS32_R2
+	select REALTEK_OTTO_TIMER if CPU_MIPS32_R2
+	help
+	  Realtek "Luna" GPON ONU SoCs built on the RLX "Taroko" core
+	  (RTL9602C/RTL9603C, MIPS32 R1, R3000-style TLB) or on the MIPS
+	  interAptiv core (RTL9607C, MIPS32 R2, R4000 TLB + GIC + CPS).
+	  Big-endian MIPS, run-from-RAM bring-up.
+
 config RALINK
 	bool "Ralink based machines"
 	select CEVT_R4K
