#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# X400AXF / RTL9607F "Elnath": hand the GPON driver THIS board's serial number.
#
# The serial number is the ONU's identity on the PON - the OLT keys ranging,
# authentication and the whole service profile on it - so it must be read from
# the board and be unique per unit. A serial number compiled into the image
# would make every unit flashed with it announce one identity and collide on a
# shared PON. Same rule and same source as the factory MAC (05_factory_mac).
#
# Provisioning source (the one stock uses; live-verified 2026-07-16):
#   NAND "ubi_device" -> UBI volume "ubi_Config" (auto-attached READ-ONLY as
#   ubi0 via bootargs ubi.mtd=ubi_device) -> config_hs.xml:
#     <Value Name="GPON_SN" Value="XPONxxxxxxxx"/>
#   i.e. the very file that carries ELAN_MAC_ADDR. Stock reads the same value
#   from the same place, in userspace, and passes it to its PON/OMCI stack
#   (rc2 mounts ubi0:ubi_Config on /var/config; runomci.sh does
#   `mib get GPON_SN` - that MIB store IS this XML - and runs
#   `omci_app -s <SN>`; the PON-mode script splits the same string into the
#   4-character vendor-id and the 8-hex-digit vendor-specific serial number).
#   Nothing in stock derives the serial number from the MAC: its built-in
#   default is the generic "RTKG11111111". A unit's factory serial and MAC
#   are assigned independently; do not assume a relationship between them.
# Not a source: U-Boot env (generic placeholder), the runtime DTB (no
# bootloader fixup), the OTP (PCIe calibration only), static_conf (blank).
#
# The kernel cannot read UBIFS at probe time, so cortina-gpon holds ranging off
# until this script pushes the value in (bounded: after 60 s the driver shouts
# and ranges with a placeholder, and re-ranges when a real serial arrives).
#
# FALLBACK, when the volume has no GPON_SN: derive one from the factory base MAC
# (itself per-board, from ELAN_MAC_ADDR / eth0) as vendor-id "XPON" + the MAC's
# low 4 bytes. That keeps every unit UNIQUE, but it is NOT the factory serial
# number, so the OLT will not have it provisioned - hence the loud logger/echo.
# The fallback deliberately does not attempt to reconstruct a unit's real
# factory serial number from its MAC: that would just recreate the collision
# this script exists to prevent.
#
# Auto-enabled at image build (rootfs.mk enables every /etc/init.d script with
# the rc.common shebang). START=11: right after /etc/init.d/boot, so ranging
# starts as early as the volume is mountable.

START=11

# START=11 runs BEFORE /etc/init.d/log, so syslog may not be listening yet:
# mirror every message into the kernel ring too, where it lands next to the
# driver's own identity lines and survives into `dmesg`/the serial console.
say() {
	logger -t gpon-identity ${2:+-p daemon.err} "$1"
	echo "gpon-identity: $1" > /dev/kmsg 2>/dev/null
}

start() {
	local mnt="/tmp/.gpon_identity"
	local sn="" mac="" src=""

	[ -e /proc/gpon ] || {
		say "no /proc/gpon - the cortina-gpon driver is absent; GPON identity NOT set" err
		return 1
	}

	mkdir -p "$mnt"
	if mount -t ubifs -o ro ubi0:ubi_Config "$mnt" 2>/dev/null; then
		sn=$(sed -n 's/.*Name="GPON_SN"[^V]*Value="\([^"]\{12\}\)".*/\1/p' \
			"$mnt/config_hs.xml" 2>/dev/null | head -n1)
		mac=$(sed -n 's/.*Name="ELAN_MAC_ADDR"[^V]*Value="\([0-9a-fA-F]\{12\}\)".*/\1/p' \
			"$mnt/config_hs.xml" 2>/dev/null | head -n1)
		umount "$mnt"
	fi
	rmdir "$mnt" 2>/dev/null

	# The driver validates too; check here so the fallback can take over.
	case "$sn" in
	????[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
		src="board (ubi0:ubi_Config config_hs.xml GPON_SN)" ;;
	*)
		sn="" ;;
	esac

	if [ -z "$sn" ]; then
		[ "${#mac}" = "12" ] || \
			mac=$(tr -d : < /sys/class/net/eth0/address 2>/dev/null)
		if [ "${#mac}" = "12" ]; then
			sn="XPON$(echo "${mac#????}" | tr 'a-f' 'A-F')"
			src="MAC-derived FALLBACK - unique but NOT the factory serial number"
			say "no GPON_SN in ubi0:ubi_Config config_hs.xml - using $sn ($src); the OLT will not have this serial provisioned" err
		else
			say "no GPON_SN and no base MAC readable - leaving the driver to its own placeholder; this ONU has NO valid PON identity" err
			return 1
		fi
	fi

	if echo "sn $sn" > /proc/gpon 2>/dev/null; then
		say "GPON serial number $sn from $src"
	else
		say "the driver REJECTED serial number '$sn' (see dmesg)" err
		return 1
	fi
	return 0
}
