#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Supervise the WiFi radio reconciler (/usr/sbin/wifi-recover, which carries the
# rationale for why an unattended ONU needs one at all).
#
# procd restarts it if it ever dies, and `/etc/init.d/wifi-recover stop` parks
# it - which is the escape hatch for a test that wants a radio held down for a
# long time by means other than `wifi down`.  A plain `wifi down` needs no such
# thing: the reconciler already leaves an intentionally-downed radio alone (see
# the script).  Auto-enabled at image build (rootfs.mk enables every
# /etc/init.d script with the rc.common shebang).
#
# START=97: after network (20), wpad (19) and led-panel (95), so the first pass
# looks at settled radios - and the daemon sleeps one interval before its first
# look regardless.

START=97
USE_PROCD=1

start_service() {
	# Nothing to reconcile on an image with no wireless config at all: say
	# nothing and leave no resident process behind.
	[ -s /etc/config/wireless ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/wifi-recover
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
