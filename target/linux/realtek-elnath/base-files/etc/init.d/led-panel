#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Supervise the front-panel state LED daemon (/usr/sbin/led-panel, which carries
# the rationale for why these particular LEDs need a poller at all).
#
# procd restarts it if it ever dies, and stops it on `/etc/init.d/led-panel
# stop` - which is also how you free the LEDs to poke them by hand when
# testing.  Auto-enabled at image build (rootfs.mk enables every /etc/init.d
# script with the rc.common shebang).
#
# START=95: after the network is up, so the very first pass already sees the
# real WAN/route state instead of flickering the NET LED on.

START=95
USE_PROCD=1

start_service() {
	# Nothing to supervise if the image has no LED class at all (no LEDS_GPIO
	# in the kernel config, or no leds node in the device tree): say so once
	# instead of respawning a daemon that can never do anything.
	[ -d /sys/class/leds ] || {
		logger -t led-panel -p daemon.err \
			"no /sys/class/leds - front-panel LEDs are not available in this image"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/sbin/led-panel
	# retry 0 = respawn forever; a bare `respawn` inherits 3600 5 5 and procd
	# halts the instance for good after five deaths (see wifi-recover for the
	# full reasoning). Frozen panel LEDs are the one symptom a subscriber and
	# an ISP technician both read as "the box is dead".
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
