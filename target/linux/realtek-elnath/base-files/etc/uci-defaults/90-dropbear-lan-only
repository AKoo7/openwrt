#!/bin/sh
# Defense-in-depth on top of the firewall4 wan-input-REJECT: bind dropbear to
# the LAN interface only, so SSH is unreachable from the GPON WAN side even if
# the firewall is ever down/misconfigured. (LAN = eth0 static 192.168.1.1.)
uci -q batch <<-EOF
	set dropbear.@dropbear[0].Interface='lan'
	commit dropbear
EOF
exit 0
