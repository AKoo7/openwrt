config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

# M3d: LAN = br-lan bridging eth0 (Cortina-NI port0) with the WiFi APs
# (wlan0 2.4G + wlan1 5G join via wifi-iface network 'lan'), mirroring the
# stock br0 topology. The bring-up-era direct-eth0 config (used during M2
# while RX was still dead, to dodge a br-lan-route-shadows-eth0 artifact of
# the then-half-working datapath) is superseded now the NI datapath is solid.
# br-lan inherits eth0's (factory) MAC, so the LAN identity matches stock br0.
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'

# Stage D: gpon0 = the GPON WAN data path (cortina-gpon). Carrier comes up
# when the OLT's OMCI provisioning (data T-CONT + GEM) is installed; netifd
# then DHCPs the WAN lease (lab: 192.168.158.0/24 from hades).
#
# keepalive = "<lcp-echo-failure> <lcp-echo-interval>"; only PPPoE/PPP protos
# read it, so it is inert while proto is dhcp and is here so a switch to pppoe
# inherits a survivable value.
#
# ★ WHY: OpenWrt's ppp.sh default is keepalive="5 1" = an LCP echo EVERY SECOND
# with teardown after 5 misses -- a 5 SECOND tolerance, and pppd then EXITS
# (ppp.sh sets maxfail 1 with no persist), so netifd destroys and recreates the
# ppp netdev. Board A/B, identical 45 s upstream 60 B UDP flood:
#     keepalive default (interval 1 , failure 5): teardowns 15->18  *** BOUNCED ***
#     keepalive "5 30"  (interval 30, failure 5): teardowns 19->19  SESSION HELD
# `lcp-echo-adaptive` (on by default) does NOT save it: it suppresses echoes
# only when traffic arrives FROM the peer, and an upstream-only flow gives the
# peer nothing to send back.
#
# The values below MATCH STOCK, recovered from stock's own PPP daemon
# (bin/spppd, a BSD-sppp port driven by spppctl) at two independent points:
#   - libmib.so's startPPP() issues `spppctl katimer 20` + `spppctl echo_retry 6`
#   - spppd's .data max_alive_cnt holds 06000000 = 6
# => stock tolerates 20 s x 6 = 120 s, i.e. 24x our old window. Stock also never
# issues its `noredial`/`holdoff`/`diska` knobs, so it redials indefinitely and
# never disables keepalive.
#
# DELIBERATE DEVIATION: we keep `lcp-echo-adaptive` (stock's sppp is
# non-adaptive and lets only echo traffic reset the liveness counter). Adaptive
# is strictly MORE tolerant, so it can only help; noted here so it is a recorded
# choice and not an accidental mismatch.
#
# persist + holdoff: stock does not cap redials, and a transient echo timeout
# should not tear the netdev down and rebuild it (that is what produced the
# ifindex 10->11 churn). persist keeps pppd alive; holdoff paces reconnects.
config interface 'wan'
	option device 'gpon0'
	option proto 'dhcp'
	option keepalive '6 20'
	option persist '1'
	option holdoff '5'
