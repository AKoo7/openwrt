# CONFIG_NL80211_TESTMODE is not set
# CONFIG_CFG80211_DEVELOPER_WARNINGS is not set
# CONFIG_CFG80211_CERTIFICATION_ONUS is not set
# CFG80211_REQUIRE_SIGNED_REGDB + USE_KERNEL_REGDB_KEYS are PROMPTLESS
# "default y" symbols unless CFG80211_CERTIFICATION_ONUS is on, so a "not set"
# here CANNOT disable them - the built-in cfg80211 always demands a regdb
# SIGNATURE. The wireless-regdb package therefore ships the pristine
# maintainer-signed regulatory.db + regulatory.db.p7s pair (see the package
# Makefile) so the country (US, from config_hs.xml) actually loads; without
# it every 5 GHz channel stays world-regdomain no-IR and the 5 GHz AP cannot
# beacon.
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_DEBUGFS=y
# CONFIG_MAC80211_DEBUGFS is not set
# CONFIG_CFG80211_WEXT is not set
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=y
# CONFIG_MAC80211_MESH is not set
# CONFIG_MAC80211_LEDS is not set
# CONFIG_MAC80211_DEBUG_MENU is not set
# CONFIG_MAC80211_HWSIM is not set
CONFIG_MAC80211_HAS_RC=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT="minstrel_ht"
CONFIG_MAC80211_STA_HASH_MAX_SIZE=0
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
# rtlwifi/rtl8192fe DROPPED 2026-07-17: [10ec:0192] is an RTL8192XB (rtw89 g6
# generation), NOT an RTL8192F; the rtl8192fe driver was the wrong match and
# caused the ~half-boots SoC hang @26s on the 2.4G path. RTL_CARDS is default-y,
# so keep it explicitly off.
# CONFIG_RTL_CARDS is not set
# 5 GHz RTW8852CE [10ec:c852] behind pcie0 -- mainline rtw89, built-in like the
# rest of the WLAN stack.  Firmware embedded via EXTRA_FIRMWARE (the OpenWrt
# rtl8852ce-firmware package needs the linux-firmware tarball, absent from dl/).
CONFIG_RTW89=y
CONFIG_RTW89_CORE=y
CONFIG_RTW89_PCI=y
CONFIG_RTW89_8852C=y
CONFIG_RTW89_8852CE=y
# 2.4 GHz RTL8192XB [10ec:0192] behind pcie2 -- new rtw89 chip (MAC twin of
# the 8852C, HW chip id 0x53), clean-room files-6.18 rtw8192xb* overlay.
# STAGED, NOT YET WIRED (2026-07-17): the rtw8192xb* source is present in the
# overlay but kept OFF here so the shared kernel tree keeps building the working
# 5 GHz/GPON/eth image during the parallel GPON board session. Turn ON during a
# later integration pass (also add rtw8192xb_{table,rfk,rfk_table}.o to the
# rtw89_8192xb-objs Makefile line, else the link fails on missing table/rfk syms).
# WIRED ON 2026-07-17 (board bring-up): enum RTL8192XB + the 55 chip_id==RTL8852C
# core ADD-sites (core/mac/pci/debug/coex) applied via files-6.18 overlay; fw blob
# rtw89/rtw8192xb_fw-2.bin embedded below.  The 8852C/GPON/eth objects are untouched.
CONFIG_RTW89_8192XB=y
CONFIG_RTW89_8192XBE=y
# CONFIG_RTW89_USB is not set
# CONFIG_RTW89_8851BE is not set
# CONFIG_RTW89_8852AE is not set
# CONFIG_RTW89_8852BE is not set
# CONFIG_RTW89_8852BTE is not set
# CONFIG_RTW89_8922AE is not set
CONFIG_RTW89_DEBUGMSG=y
CONFIG_RTW89_DEBUG=y
CONFIG_RTW89_DEBUGFS=y
# RTW89_CORE selects WANT_DEV_COREDUMP -> DEV_COREDUMP goes default-y (closure)
CONFIG_WANT_DEV_COREDUMP=y
CONFIG_DEV_COREDUMP=y
CONFIG_EXTRA_FIRMWARE="rtw89/rtw8852c_fw-2.bin rtw89/rtw8192xb_fw-2.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
# CONFIG_MAC80211_MESSAGE_TRACING is not set
