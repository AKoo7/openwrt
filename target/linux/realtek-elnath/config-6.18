# SPI-NAND factory-provisioning read path: the per-board MAC (ELAN_MAC_ADDR)
# and GPON_SN live in config_hs.xml on the stock ubi_Config UBI volume.
# Cortina QSPI controller + SPI-NAND core + UBI/UBIFS, attached/mounted
# READ-ONLY (all DTS partitions carry read-only; NAND is never written).
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BEB_LIMIT=20
CONFIG_MTD_UBI_BLOCK=y
CONFIG_MTD_UBI_FASTMAP=y
CONFIG_MTD_UBI_WL_THRESHOLD=4096
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MEM=y
CONFIG_SPI_CORTINA_QSPI=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_XATTR=y
CONFIG_UBIFS_FS_ZLIB=y
CONFIG_UBIFS_FS_ZSTD=y
# RTL9607F dev: /dev/mem for live register spy/poke (project keeps dump-the-protocol tooling first-class)
CONFIG_DEVMEM=y

# --- Software self-recovery net (no HW-watchdog dependency) ---------------- #
# An unattended GPON ONU ships online for months; a SILENT kernel hang/lockup
# must reboot the box on its own (there is no operator to power-cycle it, and
# no HW watchdog driver wired yet -- cortina,wdt @0xf432902c is a follow-up).
# Enable the two software detectors and make each PANIC, reusing the inherited
# panic->reboot path (generic: CONFIG_PANIC_TIMEOUT=1, CONFIG_PANIC_ON_OOPS=y).
# Dependencies are generic defaults: CONFIG_DEBUG_KERNEL=y, CONFIG_BUG=y,
# CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120 (a D-state task hung 120s -> panic).
#
# ** TWO-PLACE GOTCHA (why the DETECT_HUNG_TASK / SOFTLOCKUP_DETECTOR lines below
# **  are not enough on their own): OpenWrt EXPOSES those two detectors as its own
# **  buildroot options (config/Config-kernel.in: KERNEL_DETECT_HUNG_TASK,
# **  KERNEL_SOFTLOCKUP_DETECTOR).  Its derived kernel config is merged AFTER this
# **  file, so a bare CONFIG_DETECT_HUNG_TASK=y here is overridden by the buildroot
# **  default (# ... is not set).  They are therefore ALSO enabled in the buildroot
# **  .config:  CONFIG_KERNEL_DETECT_HUNG_TASK=y  and
# **  CONFIG_KERNEL_SOFTLOCKUP_DETECTOR=y.  The panic/timeout symbols below are NOT
# **  buildroot-gated and take effect straight from this file once the two parent
# **  detectors are on.
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_DETECT_HUNG_TASK=y
# New in 6.18: enabling DETECT_HUNG_TASK exposes this sub-symbol; give it an
# explicit value so the non-interactive kernel syncconfig does not prompt+abort
# ("[Y/n/?] (NEW)"). =y (its kernel default) dumps the blocking task in the panic.
CONFIG_DETECT_HUNG_TASK_BLOCKER=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
